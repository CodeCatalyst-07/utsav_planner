# ==========================================
# Utsav Planner - Environment Configuration
# ==========================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or .env*.local to source control.
# Never prefix any secret with NEXT_PUBLIC_.

# --- JarvisLabs (OpenAI-compatible) LLM Provider (Optional) ---
JARVISLABS_API_KEY=your_key_here
JARVIS_BASE_URL=https://models.jarvislabs.net/v1
JARVIS_MODEL=gemma-4-31b-it
JARVIS_JSON_MODE=prompt_only
# Default is {}. Keeping reasoning/thinking enabled is recommended because disabling it reduces complex dietary menu validity from 100% to 80%.
# To test disabling thinking for ultra-low latency on simple tasks: {"chat_template_kwargs":{"enable_thinking":false}}
JARVIS_EXTRA_BODY_JSON={}

# --- Google Gemini LLM Provider (Optional failover; free tier allows 20 requests/day) ---
# Jarvis is primary; Gemini is an optional secondary failover. The critic is off by default.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=your_gemini_model_id

# --- AI Runtime Configuration ---
LLM_TIMEOUT_MS=20000
AI_CACHE_TTL_SECONDS=1800
# Optional Gemini Critic: false by default to conserve free-tier quota; enable once free-tier quota is confirmed
CRITIC_ENABLED=false
GROUNDING_ENABLED=false
ALLOW_PROVIDER_OVERRIDE=false

# --- Vendor Directory Data Source ---
# Allowed values: sample | places
# Default: sample
VENDOR_SOURCE=sample

# --- Google Places API (Optional; required only if VENDOR_SOURCE=places) ---
GOOGLE_PLACES_API_KEY=your_key_here

# --- Security & Rate Limiting ---
# Requests allowed per minute per client IP
RATE_LIMIT_PER_MIN=10
# Maximum LLM requests allowed per client IP per day (default 60)
LLM_DAILY_LIMIT=60
